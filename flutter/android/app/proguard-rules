# Keep class members from protobuf generated code.
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite {
  <fields>;
}

# Keep rustls-platform-verifier classes for JNI
-keep, includedescriptorclasses class org.rustls.platformverifier.** { *; }

# ADB 无线配对：Conscrypt（JNI + provider）与 BouncyCastle（HKDF/X509 构建）
-keep class org.conscrypt.** { *; }
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
# BouncyCastle 按算法名/Provider 反射加载实现类，裁剪会导致运行期找不到算法
-keep class org.bouncycastle.** { *; }

# Flutter embedding 与官方插件（JNI/平台通道/反射均有涉及）
-keep class io.flutter.** { *; }
-keep class io.flutter.plugins.** { *; }
-dontwarn io.flutter.embedding.**

# JNI 静态绑定：Rust 导出符号 Java_ffi_FFI_* 按类名+方法名绑定，类不可混淆
-keep class ffi.FFI { *; }

# JNI 动态回调：libs/scrap/src/android/ffi.rs 通过 env.call_method 按方法名字符串
# 反射调用 MainService.rustPointerInput/rustKeyEventInput/rustGetByName/rustSetByName
# 与 RdClipboardManager.rustUpdateClipboard/rustEnableClientClipboard，方法名必须保留
-keepclassmembers class com.starcaretech.a.MainService {
    *** rust*(...);
}
-keep class com.starcaretech.a.RdClipboardManager { *; }

# XXPermissions 按品牌 ROM 反射跳转各厂商权限页，类名/方法名裁剪后跳转失效
-keep class com.hjq.permissions.** { *; }
-dontwarn com.hjq.permissions.**

# ADB 配对：libstaradb.so 的 JNI_OnLoad 通过 FindClass + RegisterNatives
# 按名注册 native 方法，PairingContext 类名与 native* 方法名不可混淆
-keep class com.starcaretech.a.adb.PairingContext { *; }
